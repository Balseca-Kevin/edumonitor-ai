# Copia este archivo como .env en la raíz del repo y completa los valores.
# .env nunca se sube a GitHub. Todos los valores de aquí son de prueba.

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=edumonitor

# SQL Server: la contraseña necesita mayúscula, minúscula, número, símbolo y 8+ caracteres
MSSQL_SA_PASSWORD=Cambia_Esto_2026!

# Moodle de laboratorio (administrador del sitio)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Cambia_Esto_2026!
MOODLE_PORT=8080

# --- Backend (.NET lee estas variables; __ separa secciones) ---
ConnectionStrings__EduMonitorDB=Server=localhost,1433;Database=EduMonitorDB;User Id=sa;Password=Cambia_Esto_2026!;TrustServerCertificate=True
Moodle__Url=http://localhost:8080
Moodle__Servicio=edumonitor_ws
Moodle__Token=
Jwt__Secret=cambia-esto-por-una-cadena-de-al-menos-32-caracteres
Jwt__Issuer=EduMonitor
Jwt__Audience=EduMonitor
Jwt__ExpiraMinutos=120
ASPNETCORE_URLS=http://localhost:5000

# --- Agente ---
BACKEND_URL=http://localhost:5000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Frontend (Vite solo expone variables que empiezan con VITE_) ---
VITE_API_URL=http://localhost:5000
VITE_USE_MOCK=true
