# Copia este archivo como .env en la raíz del repo y completa los valores.
# .env nunca se sube a GitHub. Todos los valores de aquí son de prueba.

# --- Docker Compose ---
# Dos entornos con nombre propio, sin COMPOSE_PROJECT_NAME:
#   EduMonitor (docker-compose.yml de la raíz, proyecto edumonitor):  docker compose up -d
#   Aula virtual (moodle-lab/, proyecto aula-virtual):                 docker compose -f moodle-lab/docker-compose.yml --env-file .env up -d
# Dentro de Docker la API usa sqlserver, http://agent:8000 y http://host.docker.internal:<MOODLE_PORT> (los fija docker-compose.yml);
# las URL con localhost de abajo son para correr la API, el agente y el frontend sin Docker.

# SQL Server: la contraseña necesita mayúscula, minúscula, número, símbolo y 8+ caracteres
MSSQL_SA_PASSWORD=Cambia_Esto_2026!

# Moodle de laboratorio (administrador del sitio)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Cambia_Esto_2026!
MOODLE_PORT=8080
MOODLE_ADMIN_EMAIL=admin@edumonitor.test
# Sin espacios: el instalador de Moodle del contenedor no los maneja bien
MOODLE_SITE_NAME=Moodle-Lab-UTA
# Contraseña de la base PostgreSQL interna de Moodle (no se publica fuera de Docker)
MOODLE_DB_PASSWORD=Cambia_Esto_2026!

# --- Backend (.NET lee estas variables; __ separa secciones) ---
ConnectionStrings__EduMonitorDB=Server=localhost,1433;Database=EduMonitorDB;User Id=sa;Password=Cambia_Esto_2026!;TrustServerCertificate=True
Moodle__Url=http://localhost:8080
Moodle__Servicio=edumonitor_ws
Moodle__Token=
Jwt__Secret=cambia-esto-por-una-cadena-de-al-menos-32-caracteres
Jwt__Issuer=EduMonitor
Jwt__Audience=EduMonitor
Jwt__ExpiraMinutos=120
# Contraseña de los usuarios semilla de laboratorio (admin, doc01, doc02); solo se usa en Development
Semillas__Contrasena=Cambia_Esto_2026!
ASPNETCORE_URLS=http://localhost:5000

# --- Agente ---
# La API llama al agente aquí (en Docker, http://agent:8000 por la red interna). Pasados 60 s responde 503.
Agente__Url=http://localhost:8000
BACKEND_URL=http://localhost:5000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Frontend (Vite solo expone variables que empiezan con VITE_) ---
# Vacío: la app llama a /api en su misma dirección (nginx en Docker, el proxy de Vite en desarrollo).
VITE_API_URL=
VITE_USE_MOCK=false
